# Bau Akte Pro – Beispielkonfiguration (Werte für die lokale Entwicklung; Produktion siehe docs/tech-stack.md)
DATABASE_URL=postgres://bap_app:bap_app@localhost:54329/bap
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:54329/bap
# Produktion: langer Zufallswert (z. B. openssl rand -hex 32). Lokal wird er in storage/keys/ erzeugt.
BETTER_AUTH_SECRET=
WEB_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000
# Produktion: SMTP eines deutschen Anbieters. Leer = E-Mails landen als .eml in storage/outbox/.
SMTP_URL=
MAIL_FROM=Bau Akte Pro <noreply@bauaktepro.example.test>
# Testbenutzer (nur lokal): Passwort steht in packages/db/src/seed-ids.ts (TEST_PASSWORD).
