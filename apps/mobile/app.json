{
  "expo": {
    "name": "Bau Akte Pro",
    "slug": "bau-akte-pro",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "de.bauaktepro.dev",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Bau Akte Pro verbindet sich über das WLAN der Insta360-Kamera, um 360°-Fotos direkt aufzunehmen."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "react-native-blob-util",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Bau Akte Pro nutzt die Kamera, um Mängel auf der Baustelle zu fotografieren.",
          "photosPermission": "Bau Akte Pro nutzt deine Fotos, um sie an Mängel anzuhängen.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Bau Akte Pro nutzt die Kamera, um Mängel zu fotografieren und Raum-QR-Codes zu scannen.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "bau-akte-pro"
  }
}
